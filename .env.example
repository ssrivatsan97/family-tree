# Only needed if you run the site on your own computer with "vercel dev".
# On the real site, set these in Vercel → Settings → Environment Variables.
# The password family members type to LOOK at the tree (8+ characters).
FAMILY_PASSWORD="choose-your-own-family-password"
# Who may CHANGE the tree: Name=passcode, separated by ";".
EDITORS="Grandma=apple-cloud-58; Alex=paper-boat-31"
# Optional. If left out, a key is made automatically from the database address.
# SESSION_SECRET="a-long-random-string-of-at-least-32-characters"
# DATABASE_URL is added automatically when you connect Neon in Vercel.
